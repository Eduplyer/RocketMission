# Normalize EOL for all files that Git considers text files.
* text=auto eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gd text eol=lf
*.godot text eol=lf
*.svg text eol=lf
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.glb binary
*.gltf binary
*.fbx binary
*.obj binary
*.ogg binary
*.wav binary
*.mp3 binary
*.ttf binary
*.otf binary
*.res binary
*.scn binary